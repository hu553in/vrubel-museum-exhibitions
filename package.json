{
  "name": "vrubel-museum-exhibitions",
  "version": "0.1.0",
  "private": true,
  "description": "A website showcasing exhibitions of the Omsk Regional M. A. Vrubel Museum of Fine Arts.",
  "homepage": "https://vrubel-museum-exhibitions.vercel.app",
  "author": "Ruslan Khasanshin",
  "repository": "https://github.com/hu553in/vrubel-museum-exhibitions",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "bun fmt --check && eslint --max-warnings 0 . && stylelint --max-warnings 0 --ignore-path .gitignore '**/*.css'",
    "lint:fix": "eslint --max-warnings 0 --fix . && stylelint --max-warnings 0 --fix --ignore-path .gitignore '**/*.css' && bun fmt",
    "check:hooks": "lefthook validate",
    "check:workflows": "bunx --minimum-release-age 259200 github-actionlint",
    "check:types": "bun check",
    "check:unused": "knip",
    "check:vulns": "bun audit --prod --audit-level=high",
    "check:all": "bun lint && bun check:hooks && bun check:workflows && bun check:types && bun run build && bun check:unused && bun check:vulns && bun test:coverage",
    "check:fix": "bun lint:fix && bun check:all",
    "test": "vitest run",
    "test:coverage": "bun run test --coverage",
    "prepare": "if [ -n \"${CI:-}\" ] || [ \"${LEFTHOOK:-}\" = \"0\" ]; then exit 0; fi; lefthook install"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@react-spring/web": "^10.1.2",
    "classnames": "^2.5.1",
    "normalize.css": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-magnifier": "^3.0.4",
    "react-remove-scroll": "^2.7.2",
    "react-router": "^8.5.2",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "knip": "^6.47.0",
    "lefthook": "^2.2.2",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "bun@1.4.5"
}
