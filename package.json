{
  "name": "vrubel-museum-exhibitions",
  "version": "0.1.0",
  "description": "A website showcasing exhibitions of the Omsk Regional M. A. Vrubel Museum of Fine Arts.",
  "author": "Ruslan Khasanshin",
  "repository": "https://github.com/hu553in/vrubel-museum-exhibitions",
  "homepage": "https://vrubel-museum-exhibitions.vercel.app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "prettier -u -c . && eslint --max-warnings 0 . && stylelint --max-warnings 0 --ignore-path .gitignore '**/*.css'",
    "lint:fix": "prettier -u -w . && eslint --max-warnings 0 --fix . && stylelint --max-warnings 0 --fix --ignore-path .gitignore '**/*.css'",
    "check:workflows": "bunx github-actionlint",
    "check:types": "tsc --pretty",
    "check:unused": "knip",
    "check:vulns": "bun audit --prod --audit-level=high",
    "check": "bun lint && bun check:workflows && bun check:types && bun run build && bun check:unused && bun check:vulns && bun test:coverage",
    "check:fix": "bun lint:fix && bun check",
    "test": "vitest run",
    "test:coverage": "bun run test --coverage",
    "prepare": "if [ -n \"${CI:-}\" ] || [ \"${LEFTHOOK:-}\" = \"0\" ]; then exit 0; fi; lefthook install"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@react-spring/web": "^10.1.2",
    "classnames": "^2.5.1",
    "normalize.css": "^8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-magnifier": "^3.0.4",
    "react-remove-scroll": "^2.7.2",
    "react-router": "^8.3.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
