{
  "name": "vrubel-museum-exhibitions",
  "description": "Omsk regional M. A. Vrubel museum of fine arts exhibitions.",
  "version": "1.0.0",
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^11.2.7",
    "@testing-library/user-event": "^12.8.3",
    "classnames": "^2.5.1",
    "normalize.css": "^8.0.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-intersection-observer": "^8.34.0",
    "react-magnifier": "^3.0.4",
    "react-merge-refs": "^1.1.0",
    "react-modal": "^3.16.3",
    "react-page-visibility": "^6.4.0",
    "react-remove-scroll": "^2.7.2",
    "react-resize-detector": "^6.7.8",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "react-router-hash-link": "^2.4.3",
    "react-scripts": "^5.0.1",
    "react-sound": "^1.2.0",
    "react-spring": "^9.7.5",
    "soundmanager2": "^2.97.20170602",
    "typescript": "^4.9.5",
    "web-vitals": "^1.1.2"
  },
  "devDependencies": {
    "@types/jest": "^26.0.24",
    "@types/node": "^12.20.55",
    "@types/react": "^17.0.91",
    "@types/react-dom": "^17.0.26",
    "@types/react-modal": "^3.16.3",
    "@types/react-page-visibility": "^6.4.4",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-sound": "^1.2.6",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^3.4.1",
    "husky": "^6.0.0",
    "lint-staged": "^10.5.4",
    "prettier": "^2.8.8",
    "sass": "^1.98.0",
    "stylelint": "^13.13.1",
    "stylelint-config-recommended": "^4.0.0",
    "stylelint-config-standard": "^21.0.0"
  },
  "scripts": {
    "install-deps": "NODE_OPTIONS=--openssl-legacy-provider pnpm install",
    "start": "NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "build": "NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "test": "NODE_OPTIONS=--openssl-legacy-provider CI=true react-scripts test --passWithNoTests",
    "eject": "NODE_OPTIONS=--openssl-legacy-provider react-scripts eject",
    "prepare": "husky install"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "prettier",
      "plugin:prettier/recommended"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error",
      "no-unused-vars": "off",
      "@typescript-eslint/no-unused-vars": "error"
    }
  },
  "eslintIgnore": [
    "node_modules",
    "build",
    "target",
    "pnpm-lock.yaml"
  ],
  "stylelint": {
    "extends": [
      "stylelint-config-recommended",
      "stylelint-config-standard"
    ],
    "rules": {
      "block-no-empty": null
    }
  },
  "stylelintIgnore": [
    "node_modules/**/*",
    "build/**/*",
    "target/**/*"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.(js|ts|tsx)": "eslint --max-warnings=0 --fix",
    "*.scss": "stylelint --max-warnings=0 --fix"
  }
}
