{
  "name": "vrubel-museum-exhibitions",
  "description": "Omsk regional M. A. Vrubel museum of fine arts exhibitions.",
  "version": "1.0.0",
  "dependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "classnames": "^2.5.1",
    "normalize.css": "^8.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-intersection-observer": "^10.0.3",
    "react-magnifier": "^3.0.4",
    "react-merge-refs": "^3.0.2",
    "react-modal": "^3.16.3",
    "react-page-visibility": "^7.0.0",
    "react-remove-scroll": "^2.7.2",
    "react-resize-detector": "^12.3.0",
    "react-router": "^7.13.2",
    "react-router-dom": "^7.13.2",
    "react-router-hash-link": "^2.4.3",
    "react-scripts": "^5.0.1",
    "react-sound": "^1.2.0",
    "react-spring": "^10.0.3",
    "soundmanager2": "^2.97.20170602",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-modal": "^3.16.3",
    "@types/react-page-visibility": "^6.4.4",
    "@types/react-sound": "^1.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "sass": "^1.98.0",
    "stylelint": "^17.6.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "scripts": {
    "install-deps": "NODE_OPTIONS=--openssl-legacy-provider pnpm install",
    "build": "NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "dev": "NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "test": "NODE_OPTIONS=--openssl-legacy-provider CI=true react-scripts test --passWithNoTests",
    "lint": "eslint --max-warnings=0 . && stylelint --max-warnings=0 \"**/*.{css,sass,scss}\"",
    "lint:fix": "prettier --write . && eslint --max-warnings=0 --fix . && stylelint --max-warnings=0 --fix \"**/*.{css,sass,scss}\"",
    "prepare": "husky"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "prettier",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "prettier/prettier": "error",
      "no-unused-vars": "off",
      "@typescript-eslint/no-unused-vars": "error"
    }
  },
  "eslintIgnore": [
    "node_modules",
    "build",
    "target"
  ],
  "stylelint": {
    "extends": [
      "stylelint-config-recommended",
      "stylelint-config-standard"
    ],
    "rules": {
      "selector-class-pattern": null
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --max-warnings=0 --fix",
    "*.{css,sass,scss}": "stylelint --max-warnings=0 --fix"
  }
}
